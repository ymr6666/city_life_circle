# 城市时域生活圈分析系统 —— 部署环境变量模板
# 复制为 config.env 并修改 (或直接 export / set 到系统环境变量), 后端会自动读取。

# ── 数据库 ────────────────────────────────────────────────
CLC_DB_HOST=localhost
CLC_DB_PORT=5432
CLC_DB_NAME=city_life_circle
CLC_DB_USER=postgres
CLC_DB_PASSWORD=请修改为你的数据库密码

# ── 出行速度 (km/h, 一般无需修改) ──────────────────────────
# CLC_WALK_KMH=5.0
# CLC_CYCLE_KMH=15.0
# CLC_DRIVE_KMH=30.0
# CLC_METRO_KMH=35.0
# CLC_BUS_KMH=20.0

# ── 第三方 key (缺失时部分功能降级, 核心分析不受影响) ──────────
# 高德 Web 服务 key (地址搜索/逆地理编码)
# AMAP_KEY=你的高德key
# 天地图瓦片 key (前端 .env.local 的 VITE_TIANDITU_KEY, 缺失回退 OSM)
